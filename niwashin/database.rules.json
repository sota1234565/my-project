{
  "rules": {
    "greenItems": {
      ".read": true,
      "$id": {
        ".write": "(!data.exists() && newData.child('status').val() === 'pending') || auth.token.email === 'sota2007710@gmail.com' || (data.exists() && !newData.exists() && data.child('status').val() === 'pending')",
        "condition": {
          ".write": true,
          ".validate": "newData.isString() && newData.val().matches(/^(healthy|needs_care|poor)$/)"
        },
        "location": {
          "address": {
            ".write": true,
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "muniCd": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^[0-9]{5}$/))"
          },
          "muniName": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 30)"
          }
        },
        "supporters": {
          "$uid": {
            ".write": true,
            ".validate": "newData.val() === true"
          }
        },
        "observations": {
          "$obsId": {
            ".write": "!data.exists() || (!newData.exists() && data.child('photoId').exists())",
            ".validate": "newData.hasChildren(['userId','text','date','createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 500 && !newData.child('text').val().matches(/(死ね|しね|殺す|ころす|バカ|馬鹿|アホ|カス|クズ|キモ|ブス|デブ|ハゲ|ウザ|うざ|キチガイ|きちがい|ガイジ|池沼|糞|クソ|くそ|うんこ|ウンコ|ちんこ|チンコ|ちんちん|チンチン|まんこ|マンコ|おっぱい|オッパイ|セックス|せっくす|エロ|えろ|レイプ|売春|風俗|変態|へんたい|fuck|shit|bitch|asshole|dick|pussy|cock|porn|rape|nigger|faggot|cunt|whore|slut)/i) && (!newData.child('photoId').exists() || newData.child('photoId').isString())"
          }
        }
      }
    },
    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth.token.email === 'sota2007710@gmail.com'",
        "name": {
          ".write": true,
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20 && !newData.val().matches(/(死ね|しね|殺す|ころす|バカ|馬鹿|アホ|カス|クズ|キモ|ブス|デブ|ハゲ|ウザ|うざ|キチガイ|きちがい|ガイジ|池沼|糞|クソ|くそ|うんこ|ウンコ|ちんこ|チンコ|ちんちん|チンチン|まんこ|マンコ|おっぱい|オッパイ|セックス|せっくす|エロ|えろ|レイプ|売春|風俗|変態|へんたい|fuck|shit|bitch|asshole|dick|pussy|cock|porn|rape|nigger|faggot|cunt|whore|slut)/i)"
        },
        "hidden": {
          ".write": true,
          ".validate": "newData.isBoolean() && newData.val() === true"
        },
        "publicProfile": {
          ".write": true,
          ".validate": "newData.isBoolean() && newData.val() === true"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "photoLogs": {
      ".read": true,
      "$itemId": {
        "$photoId": {
          ".write": "!data.exists() || !newData.exists()",
          ".validate": "newData.hasChildren(['userId','photo','createdAt']) && newData.child('photo').isString() && newData.child('photo').val().length > 0 && newData.child('photo').val().length <= 400000"
        }
      }
    }
  }
}
